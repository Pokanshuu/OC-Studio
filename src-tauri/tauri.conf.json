{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OC-Studio",
  "version": "0.1.1",
  "identifier": "com.ocstudio.ocstudio",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OC Studio",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,

        "minWidth": 1050,
        "minHeight": 625,

        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
